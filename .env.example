# Copy this file to .env and set one provider key locally. Never commit .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_EVAL_MODEL=openai/gpt-oss-120b
GROQ_MIN_INTERVAL_SECONDS=10

# Alternative provider:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Local multilingual embeddings for RAGAS answer relevancy.
EVAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
